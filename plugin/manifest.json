{
  "manifestVersion": 5,
  "id": "com.noisecore.dreamlog",
  "name": "Noisecore Dreamlog",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "noisecoreDreamlogPanel",
      "label": {
        "default": "Noisecore Dreamlog"
      },
      "minimumSize": { "width": 230, "height": 200 },
      "preferredDockedSize": { "width": 300, "height": 500 },
      "preferredFloatingSize": { "width": 300, "height": 500 }
    }
  ]
}
