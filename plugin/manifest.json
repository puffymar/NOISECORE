{
  "manifestVersion": 5,
  "id": "com.noisecore.dreamlog",
  "name": "Noisecore Dreamlog",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "noisecoreDreamlogPanel",
      "label": {
        "default": "Noisecore Dreamlog"
      },
      "minimumSize": { "width": 300, "height": 400 },
      "preferredDockedSize": { "width": 380, "height": 720 },
      "preferredFloatingSize": { "width": 420, "height": 850 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
