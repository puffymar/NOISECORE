{
  "manifestVersion": 5,
  "id": "com.noisecore.dreamlog",
  "name": "Noisecore Dreamlog",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "noisecoreDreamlogPanel",
      "label": {
        "default": "Noisecore Dreamlog"
      },
      "minimumSize": { "width": 320, "height": 480 },
      "preferredDockedSize": { "width": 360, "height": 720 },
      "preferredFloatingSize": { "width": 400, "height": 800 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel-light.png", "scale": [1, 2], "theme": ["lightest", "light", "medium"] },
        { "width": 23, "height": 23, "path": "icons/panel-dark.png",  "scale": [1, 2], "theme": ["dark", "darkest"] }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  },
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin-icon.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "light", "lightest", "all"], "species": ["pluginList"] }
  ]
}
