{
  "manifestVersion": 5,
  "id": "com.noisecore.dreamlog",
  "name": "Noisecore Dreamlog",
  "version": "2.0.0",
  "main": "index.html",
  "host": [{ "app": "PS", "minVersion": "24.0.0" }],
  "entrypoints": [
    {
      "type": "panel",
      "id": "noisecore-dreamlog-panel",
      "label": { "default": "Noisecore Dreamlog" },
      "minimumSize": { "width": 360, "height": 560 },
      "maximumSize": { "width": 1200, "height": 1800 },
      "preferredDockedSize": { "width": 420, "height": 780 },
      "preferredFloatingSize": { "width": 420, "height": 850 }
    }
  ],
  "requiredPermissions": { "localFileSystem": "fullAccess" }
}
