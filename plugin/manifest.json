{
  "manifestVersion": 5,
  "id": "com.noisecore.dreamlog",
  "name": "Noisecore Dreamlog",
  "version": "2.0.2",
  "main": "main.js",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "noisecore-dreamlog-panel",
      "label": {
        "default": "Noisecore Dreamlog"
      },
      "minimumSize": {
        "width": 360,
        "height": 560
      },
      "maximumSize": {
        "width": 1200,
        "height": 1800
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 780
      }
    }
  ]
}
